// =============================================================================
// Framework-Independent Guideline Model (FIGM)
// Prisma Schema for Supabase PostgreSQL Production SaaS Platform
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DEVELOPER
  AUDITOR
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum NotificationType {
  SCAN_SUCCESS
  SCAN_FAILED
  AI_FINISHED
  EXPORT_FINISHED
  SECURITY_ALERT
}

enum AuditAction {
  REGISTER
  LOGIN
  LOGOUT
  REFRESH_TOKEN
  FORGOT_PASSWORD
  RESET_PASSWORD
  ACCESS_DENIED
  CREATE_PROJECT
  DELETE_PROJECT
  SCAN_RUN
  RESEARCH_PARTICIPANT_ASSIGNED
  RESEARCH_CONSENT_VERIFIED
  RESEARCH_CONSENT_REVOKED
}

// Server-verifiable research-eligibility state for a participant User row (see
// app/api/user-study/log-scan/route.ts). ASSIGNED = a participant code has been issued and bound
// to a signed session token, but no consent verification has occurred yet -- this is the only
// state a participant can be in while running the benchmark-scan portion of the study, because the
// study protocol itself has the participant complete the scan task BEFORE submitting the external
// consent/questionnaire Google Form (see app/user-study/page.tsx's own instructions). Never
// auto-promoted to CONSENT_VERIFIED; that only happens via an ADMIN-operated action once the
// researcher has reconciled a real Google Form submission against this participant code. REVOKED
// marks a participant assignment (e.g. known QA/test contamination) as no longer able to accept
// further research-scan writes, without deleting its existing historical records.
enum ResearchParticipantStatus {
  ASSIGNED
  CONSENT_VERIFIED
  REVOKED
}

enum ExportFormat {
  PDF
  JSON
  CSV
  MARKDOWN
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String      @map("password_hash")
  fullName         String      @map("full_name")
  role             UserRole    @default(DEVELOPER)
  resetToken       String?     @map("reset_token")
  resetTokenExpiry DateTime?   @map("reset_token_expiry")
  refreshToken     String?     @map("refresh_token")
  apiKey           String?     @unique @map("api_key")
  avatarUrl        String?     @map("avatar_url")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  lastLoginAt      DateTime?   @map("last_login_at")

  // Research-participant fields. Null/unused for every ordinary (non-study) account. See
  // ResearchParticipantStatus's own doc comment and src/engine/participant-repository.ts.
  // `participantCode` is the single authoritative "P001".."P085"-shaped identity every UI/API/
  // export surface must resolve through -- deliberately NOT the same as `id` for any row assigned
  // after this field was introduced (id is a normal random UUID like every other user), closing
  // the audit finding that the displayed participant code and the database primary key were
  // previously the same value. Existing pre-migration participant rows keep their original
  // P-shaped `id` and are backfilled with a matching `participantCode` so every consumer can query
  // through this one field uniformly regardless of when the row was created.
  participantCode           String?                    @unique @map("participant_code")
  researchStatus            ResearchParticipantStatus? @map("research_status")
  researchAssignedAt        DateTime?                  @map("research_assigned_at")
  researchConsentVerifiedAt DateTime?                  @map("research_consent_verified_at")

  projects            Project[]
  scanReports         ScanReport[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            Settings?
  apiKeys             ApiKey[]
  savedReports        SavedReport[]
  researchEvaluations ResearchEvaluation[]
  aiHistories         AiHistory[]
  exportHistories     ExportHistory[]
  submissions         Submission[]

  @@map("users")
}

model Project {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  name         String
  description  String        @default("")
  framework    String        @default("React")
  repoUrl      String        @default("") @map("repo_url")
  status       ProjectStatus @default(ACTIVE)
  qualityScore Int           @default(100) @map("quality_score")
  totalScans   Int           @default(0) @map("total_scans")
  lastScanAt   DateTime?     @map("last_scan_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanReports ScanReport[]

  @@index([userId])
  @@index([status])
  @@map("projects")
}

model ScanReport {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  projectId     String?  @map("project_id")
  fileName      String   @map("file_name")
  framework     String   @default("React")
  repositoryUrl String   @default("Local Repository") @map("repository_url")
  scanTimeMs    Float    @default(0.0) @map("scan_time_ms")
  memoryUsageMb Float    @default(0.0) @map("memory_usage_mb")
  qualityScore  Int      @default(100) @map("quality_score")
  ruleCount     Int      @default(0) @map("rule_count")
  // Per-severity finding counts, computed server-side at scan-persistence time from the same
  // diagnostics array (see src/engine/quality-score.ts's severityCountsFromDiagnostics -- the
  // single canonical source, never duplicated) and stored as first-class columns so the history
  // LIST endpoint can show a severity breakdown without loading/parsing the (potentially large)
  // `diagnostics` JSON blob for every row on every page load.
  criticalCount Int      @default(0) @map("critical_count")
  highCount     Int      @default(0) @map("high_count")
  mediumCount   Int      @default(0) @map("medium_count")
  lowCount      Int      @default(0) @map("low_count")
  aiFixCount    Int      @default(0) @map("ai_fix_count")
  diagnostics   Json     @default("[]")
  isFavorite    Boolean  @default(false) @map("is_favorite")
  createdAt     DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  savedReports SavedReport[]
  aiHistories  AiHistory[]

  @@index([userId])
  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@map("scan_reports")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  email     String?
  action    AuditAction
  ipAddress String      @map("ip_address")
  userAgent String      @map("user_agent")
  status    String      @default("SUCCESS")
  details   String?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Settings {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  theme        String   @default("dark")
  autoSave     Boolean  @default(true) @map("auto_save")
  autoScan     Boolean  @default(true) @map("auto_scan")
  aiModel      String   @default("gemini-2.5-flash") @map("ai_model")
  exportFormat String   @default("PDF") @map("export_format")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  key       String    @unique
  name      String    @default("Default API Key")
  lastUsed  DateTime? @map("last_used")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model SavedReport {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  scanReportId String   @map("scan_report_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanReport ScanReport @relation(fields: [scanReportId], references: [id], onDelete: Cascade)

  @@map("saved_reports")
}

model ResearchEvaluation {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  datasetName    String   @map("dataset_name")
  sampleCount    Int      @map("sample_count")
  precisionScore Float    @map("precision_score")
  recallScore    Float    @map("recall_score")
  f1Score        Float    @map("f1_score")
  accuracyScore  Float    @map("accuracy_score")
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("research_evaluations")
}

model FrameworkBenchmark {
  id             String   @id @default(uuid())
  framework      String
  sampleCount    Int      @map("sample_count")
  avgLatencyMs   Float    @map("avg_latency_ms")
  avgMemoryMb    Float    @map("avg_memory_mb")
  avgScore       Float    @map("avg_score")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("framework_benchmarks")
}

model AiHistory {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  scanReportId  String?  @map("scan_report_id")
  ruleId        String   @map("rule_id")
  patchContent  String   @map("patch_content")
  applied       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanReport ScanReport? @relation(fields: [scanReportId], references: [id], onDelete: SetNull)

  @@map("ai_history")
}

// Backs POST/GET /api/submissions -- previously that route bypassed the storage-provider
// abstraction entirely and wrote straight to the JSON-file-backed UserDB, so submissions never
// reached Postgres regardless of STORAGE_PROVIDER configuration. This model + the corresponding
// IStorageProvider methods close that gap; the route now goes through RepositoryFactory like every
// other production data path.
model Submission {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  fileName          String   @map("file_name")
  framework         String
  codeContent       String   @map("code_content")
  executionTimeMs   Float    @default(0.0) @map("execution_time_ms")
  qualityScore      Int      @default(0) @map("quality_score")
  diagnosticsCount  Int      @default(0) @map("diagnostics_count")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("submissions")
}

model ExportHistory {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  fileName  String       @map("file_name")
  format    ExportFormat
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("export_history")
}
