# =============================================================================
# FIGM SaaS Production Platform — Environment Configuration Template
# Supabase PostgreSQL + Vercel Deployment Settings
# =============================================================================

# Storage Provider Strategy ('supabase' or 'json')
STORAGE_PROVIDER="supabase"

# JWT Security Keys (Replace with strong random strings, e.g. `openssl rand -hex 32`, in Vercel
# Dashboard / your secrets manager. Required outside local development and automated tests -- the
# app refuses to start with a predictable fallback secret anywhere else.)
JWT_SECRET="YOUR_PRODUCTION_JWT_SECRET_STRING"
REFRESH_SECRET="YOUR_PRODUCTION_REFRESH_SECRET_STRING"

# Password used to bootstrap the two default ADMIN accounts on first boot (empty/missing local DB
# file only -- ignored once the DB already has users). Required (min 12 chars) outside local
# development/test; the app will not seed a default admin with a predictable password anywhere
# else. Generate with e.g. `openssl rand -base64 24`, set it once, then rotate/remove it.
ADMIN_BOOTSTRAP_PASSWORD="YOUR_STRONG_RANDOM_ADMIN_BOOTSTRAP_PASSWORD"

# Google Gemini API key for AI-assisted remediation (src/ai/gemini-service.ts). Optional -- if
# unset, AI-fix requests transparently fall back to the deterministic template remediation engine.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase Cloud Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Database Connection URLs (Supabase Pooler & Direct)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="https://YOUR-APP-NAME.vercel.app"
NODE_ENV="production"
