# =============================================================================
# FIGM SaaS Production Platform — Environment Configuration Template
# Supabase PostgreSQL + Vercel Deployment Settings
# =============================================================================

# Storage Provider Strategy ('supabase' or 'json')
STORAGE_PROVIDER="supabase"

# JWT Security Keys (Replace with strong random strings in Vercel Dashboard)
JWT_SECRET="YOUR_PRODUCTION_JWT_SECRET_STRING"
REFRESH_SECRET="YOUR_PRODUCTION_REFRESH_SECRET_STRING"

# Supabase Cloud Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Database Connection URLs (Supabase Pooler & Direct)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="https://YOUR-APP-NAME.vercel.app"
NODE_ENV="production"
