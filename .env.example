# =============================================================================
# FIGM SaaS Production Platform — Environment Configuration Template
# Supabase PostgreSQL + Vercel Deployment Settings
# =============================================================================

# Storage Provider Strategy ('supabase' or 'json')
STORAGE_PROVIDER="supabase"

# JWT Security Keys (Replace with strong random strings, e.g. `openssl rand -hex 32`, in Vercel
# Dashboard / your secrets manager. Required outside local development and automated tests -- the
# app refuses to start with a predictable fallback secret anywhere else.)
JWT_SECRET="YOUR_PRODUCTION_JWT_SECRET_STRING"
REFRESH_SECRET="YOUR_PRODUCTION_REFRESH_SECRET_STRING"

# Password used to bootstrap the two default ADMIN accounts on first boot (empty/missing local DB
# file only -- ignored once the DB already has users). Required (min 12 chars) outside local
# development/test; the app will not seed a default admin with a predictable password anywhere
# else. Generate with e.g. `openssl rand -base64 24`, set it once, then rotate/remove it.
ADMIN_BOOTSTRAP_PASSWORD="YOUR_STRONG_RANDOM_ADMIN_BOOTSTRAP_PASSWORD"

# AI-assisted remediation (Layer 2) -- src/ai/ai-provider-selector.ts picks whichever of these is
# configured: local Ollama is preferred when OLLAMA_BASE_URL or OLLAMA_MODEL is set, then Claude when
# ANTHROPIC_API_KEY is set, then Gemini when only GEMINI_API_KEY is set. Deterministic AST fixers
# (src/engine/ast-fix-engine.ts and friends) always run regardless of any of these; if none is set,
# only rules with no deterministic fixer report an explicit "automated fix unavailable" result
# instead of an AI-authored patch. There is no template-based fallback.
#
# Mid-remediation provider fallback: if the active (primary) provider becomes unavailable partway
# through an attempt -- HTTP 402/429, a timeout, or an authentication/configuration failure, never a
# real code-quality rejection like an oversized patch or an unresolved re-scan, which always retries
# the SAME provider instead -- src/ai/ai-remediation-pipeline.ts automatically switches to a fallback
# provider and continues within the SAME bounded attempt budget (never a second, separate one). With
# no explicit override, the default fallback order is CLAUDE > GEMINI > OLLAMA, skipping whichever of
# those IS the primary that just failed and using the first of the rest that is actually configured.
# AI_PRIMARY_PROVIDER / AI_FALLBACK_PROVIDER below let a deployment pin this explicitly instead of
# relying on the default precedence.

# Optional -- explicitly pins which provider serves first, overriding the default Ollama > Claude >
# Gemini precedence above. One of OLLAMA | CLAUDE | GEMINI. Ignored (falls through to the default
# precedence) if it names a provider whose own credential isn't actually configured.
AI_PRIMARY_PROVIDER="CLAUDE"
# Optional -- explicitly pins the provider src/ai/ai-remediation-pipeline.ts switches to when the
# primary becomes unavailable mid-remediation, overriding the default CLAUDE > GEMINI > OLLAMA
# fallback order. One of OLLAMA | CLAUDE | GEMINI. Ignored under the same "must be actually
# configured" rule as AI_PRIMARY_PROVIDER above, and never resolves to the SAME provider that just
# failed.
AI_FALLBACK_PROVIDER="GEMINI"

# Local Ollama endpoint for AI-assisted remediation (src/ai/providers/ollama-provider.ts).
# LOCAL DEVELOPMENT ONLY. Setting EITHER OLLAMA_BASE_URL or OLLAMA_MODEL activates this provider
# (highest precedence -- see note above); the other var then falls back to the local-dev defaults
# shown here. Never set these in a Vercel/production environment unless OLLAMA_BASE_URL points at a
# real remote/private Ollama endpoint you control -- Vercel's runtime has no network path to your
# local machine's 127.0.0.1. NEXT_PUBLIC_* is never used for these -- the browser never talks to
# Ollama directly.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Must already be pulled locally (`ollama list`) -- this does not trigger a download. The server
# always uses exactly this configured model; nothing in the request path lets a client override it.
OLLAMA_MODEL="qwen2.5-coder:7b"
# Optional -- overrides the default per-request timeout (ms) for local Ollama generation calls.
# Local CPU/GPU-constrained inference is slower than a hosted API, so this defaults higher (120000)
# than Anthropic's/Gemini's own timeouts.
OLLAMA_TIMEOUT_MS="120000"

# Anthropic Claude API key for AI-assisted remediation (src/ai/claude-client.server.ts /
# src/ai/providers/claude-provider.ts). Optional -- see note above.
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# Google Gemini API key for AI-assisted remediation (src/ai/providers/gemini-provider.ts, via the
# official @google/genai SDK). Optional -- see note above. This is the documented default fallback
# target when Claude becomes unavailable mid-remediation; it can also serve as the primary provider
# on its own (see AI_PRIMARY_PROVIDER above), or as a last-resort default when it is the ONLY
# provider configured. Get a key at https://ai.google.dev/gemini-api/docs. Never
# NEXT_PUBLIC_GEMINI_API_KEY -- this call happens server-side only, exactly like every other AI
# provider here.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Gemini model id to use for AI-assisted remediation. Optional -- defaults to gemini-3.6-flash when
# unset (verified live against the real API; gemini-2.5-flash now returns 404 for new-account keys).
GEMINI_MODEL="gemini-3.6-flash"

# Supabase Cloud Credentials
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Database Connection URLs (Supabase Pooler & Direct)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="https://YOUR-APP-NAME.vercel.app"
NODE_ENV="production"
